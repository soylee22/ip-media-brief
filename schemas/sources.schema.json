{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "title": "Source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaults", "sources"],
  "properties": {
    "defaults": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "desk", "adapter"],
        "allOf": [
          {"if": {"properties": {"adapter": {"const": "gnews"}}}, "then": {"required": ["query"]}, "else": {"required": ["url"]}},
          {"if": {"properties": {"adapter": {"enum": ["html_list", "embedded_json"]}}}, "then": {"required": ["extract"]}}
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"},
          "name": {"type": "string"},
          "desk": {"type": "string", "enum": ["ip", "media"]},
          "adapter": {"type": "string", "enum": ["rss", "gnews", "govuk_search", "fcl", "html_list", "embedded_json"]},
          "url": {"type": "string"},
          "query": {"type": "string"},
          "params": {"type": "object"},
          "homepage": {"type": "string"},
          "enabled": {"type": "boolean"},
          "disabled_reason": {"type": "string"},
          "priority": {"type": "integer", "enum": [1, 2, 3]},
          "paging": {"type": "string", "enum": ["none", "wordpress", "blogger", "fcl", "govuk"]},
          "paywalled": {"type": "boolean"},
          "fetch_article": {"type": "boolean"},
          "max_new_per_run": {"type": "integer", "minimum": 1, "maximum": 200},
          "jurisdictions": {"type": "array", "items": {"type": "string", "enum": ["uk", "eu", "us", "cn", "global"]}},
          "topics_hint": {"type": "array", "items": {"type": "string"}},
          "include": {"type": "array", "items": {"type": "string"}},
          "exclude": {"type": "array", "items": {"type": "string"}},
          "licence_note": {"type": "string"},
          "extract": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item": {"type": "string"},
              "link": {"type": "string"},
              "title": {"type": "string"},
              "title_strip_regex": {"type": "string"},
              "date_regex": {"type": "string"},
              "date_format": {"type": "string"},
              "unescape_html": {"type": "boolean"},
              "pattern": {"type": "string"}
            }
          },
          "verified": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": {"type": "string"},
              "status": {"type": "integer"},
              "items": {"type": "integer"},
              "note": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
